{
  "name": "minneapolis-from-above",
  "version": "1.0.0",
  "description": "Ambient living map of Minneapolis–Saint Paul: live transit moving on real streets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "preview": "wrangler pages dev dist",
    "deploy": "node scripts/build-satellites.mjs && npm run build && wrangler pages deploy dist",
    "build:data": "node scripts/build-gtfs.mjs",
    "perf": "node scripts/perf.mjs",
    "shot": "node scripts/shot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "build:freeways": "node scripts/build-mndot.mjs",
    "build:sats": "node scripts/build-satellites.mjs",
    "build:ucs": "node scripts/build-ucs.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "maplibre-gl": "5.24.0",
    "satellite.js": "7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  },
  "private": true
}

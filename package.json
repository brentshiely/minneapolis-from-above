    "@deck.gl/mapbox": "^9.4.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "fflate": "^0.8.3",

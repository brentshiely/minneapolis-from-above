# Hashed build output never changes under its name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Baked data files change only on deploy: revalidate cheaply, serve stale while doing so.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# The page itself must pick up each deploy's new hashed bundles at once.
/
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://tiles.openfreemap.org>; rel=preconnect; crossorigin

# Every API answer is also cached at the edge (functions/_lib/edgecache.ts).
/api/*
  X-Content-Type-Options: nosniff
